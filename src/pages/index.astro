---
import MainLayout from "../layouts/MainLayout.astro";
import type { PokemonListResponse } from "../interfaces/pokemon-list.response";
import PokemonCard from "../components/pokemons/PokemonCard.astro";
const title = "Pokemon Static | Home";
const headline = "Pokemon List";

const resp = await fetch("https://pokeapi.co/api/v2/pokemon");
const data = (await resp.json()) as PokemonListResponse;
const pokemon = data.results;
console.log("~data:", data);
---

<MainLayout title={title}>
	<h1
		class="text-5xl font-extrabold text-center mb-12 text-transparent bg-clip-text bg-gradient-to-r from-blue-400 to-purple-600 drop-shadow-sm"
	>
		{headline}
	</h1>
	<section
		class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-8 px-4"
		aria-label="Pokemon List"
	>
		{
			data.results.map(({ name, url }) => (
				<PokemonCard name={name} url={url} />
			))
		}
	</section>
</MainLayout>
