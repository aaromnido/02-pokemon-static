---
import type { PokemonDetailsResponse } from "../../interfaces/pokemon-details.response";

interface Props {
    url: string;
    name: string;
}

const { name, url } = Astro.props;
const id = url.split("/").at(-2);
const imageUrl = `https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/other/official-artwork/${id}.png`;

let stats = [];
try {
    const resp = await fetch(url);
    if (!resp.ok) throw new Error(`Failed to fetch ${url}: ${resp.statusText}`);
    const data = (await resp.json()) as PokemonDetailsResponse;
    stats = data.stats
        .map((s) => ({
            name: s.stat.name,
            value: s.base_stat,
        }))
        .slice(0, 4);
} catch (error) {
    console.error(`Error fetching stats for ${name}:`, error);
    // Fallback stats or empty
    stats = [
        { name: "hp", value: "??" },
        { name: "attack", value: "??" },
        { name: "defense", value: "??" },
        { name: "speed", value: "??" },
    ];
}
---

<article
    class="group w-full h-[300px] perspective-1000 cursor-pointer transition-transform duration-500 hover:scale-105"
>
    <div
        class="relative w-full h-full transition-transform duration-700 transform-style-3d"
        id={`card-${id}`}
    >
        <!-- Front -->
        <div
            class="absolute w-full h-full backface-hidden rounded-2xl flex flex-col items-center justify-center p-4 border border-white/10 bg-white/5 backdrop-blur-sm shadow-lg overflow-hidden"
        >
            <div
                class="absolute inset-0 bg-gradient-to-br from-white/10 to-transparent pointer-events-none"
            >
            </div>
            <img
                src={imageUrl}
                alt={name}
                class="w-full h-auto object-contain max-h-[180px] drop-shadow-[0_10px_10px_rgba(0,0,0,0.5)] z-10 transition-transform duration-500 group-hover:scale-110"
            />
            <h3
                class="text-xl font-bold capitalize text-center mt-4 text-white tracking-wide z-10"
            >
                {name}
            </h3>
        </div>

        <!-- Back -->
        <div
            class="absolute w-full h-full backface-hidden rotate-y-180 rounded-2xl flex flex-col items-center justify-center p-6 border border-white/10 bg-white/10 backdrop-blur-md shadow-xl"
        >
            <h3
                class="text-2xl font-bold capitalize text-center mb-6 text-white/90"
            >
                {name} Stats
            </h3>
            <ul class="w-full space-y-3">
                {
                    stats.map((stat) => (
                        <li class="flex justify-between items-center text-base border-b border-white/10 pb-1">
                            <span class="capitalize text-white/70 font-light">
                                {stat.name}
                            </span>
                            <span class="font-semibold text-white">
                                {stat.value}
                            </span>
                        </li>
                    ))
                }
            </ul>
        </div>
    </div>
</article>

<style>
    .perspective-1000 {
        perspective: 1000px;
    }
    .transform-style-3d {
        transform-style: preserve-3d;
    }
    .backface-hidden {
        backface-visibility: hidden;
    }
    .rotate-y-180 {
        transform: rotateY(180deg);
    }
</style>

<script>
    // Optional: Add click handler if hover isn't enough or for mobile support
    const cards = document.querySelectorAll("article");
    cards.forEach((card) => {
        card.addEventListener("click", () => {
            const inner = card.querySelector("div");
            inner?.classList.toggle("rotate-y-180");
            // Remove hover effect class if we are clicking to toggle,
            // or handle conflict. For now, hover is simple and effective.
            // If we want click-only, we should remove group-hover:rotate-y-180 from the HTML
            // and rely solely on this script.
            // The user asked for "click", so let's prioritize click.
        });
    });
</script>
