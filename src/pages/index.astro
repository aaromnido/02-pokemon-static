---
import MainLayout from "../layouts/MainLayout.astro";
import type { PokemonListResponse } from "../interfaces/pokemon-list.response";
import PokemonCard from "../components/pokemons/PokemonCard.astro";
import { Play, Swords } from "lucide-astro";

const title = "Pokemon Static | Home";
const headline = "Pokemon List";

const resp = await fetch("https://pokeapi.co/api/v2/pokemon");
const data = (await resp.json()) as PokemonListResponse;
const pokemon = data.results;
console.log("~data:", data);
---

<MainLayout title={title}>
	<h1
		class="text-4xl font-medium text-transparent bg-clip-text bg-gradient-to-r from-yellow-400 to-orange-600 mb-8 drop-shadow-sm flex items-center justify-center gap-3 text-center mx-auto"
	>
		<Swords class="w-10 h-10 text-orange-500" />
		Pokémon World
	</h1>
	<div class="mt-8 mb-8 flex justify-center">
		<a
			href="/battle"
			class="py-4 px-8 rounded-full bg-yellow-400 hover:bg-yellow-300 text-slate-900 font-semibold text-lg transition-all shadow-lg hover:shadow-yellow-400/25 hover:-translate-y-0.5 active:translate-y-0 flex items-center justify-center gap-2"
		>
			<Play class="w-6 h-6 fill-slate-900" /> Pokémon
		</a>
	</div>

	<section
		aria-label="Listado de Pokémons"
		class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-4 mt-5"
	>
		{
			data.results.map((pokemon) => (
				<PokemonCard url={pokemon.url} name={pokemon.name} />
			))
		}
	</section>
</MainLayout>
